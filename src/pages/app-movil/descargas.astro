---
import Layout from "../../layouts/Layout.astro";
import Badge from "../../components/components-astro/Badge.astro";
import TextReveal from "../../components/components-astro/TextReveal.astro";
import {
    FiDownload,
    FiSmartphone,
    FiDatabase,
    FiCheck,
    FiCheckCircle,
    FiShield,
    FiLock,
    FiServer,
    FiMapPin,
    FiCpu,
    FiClock,
    FiAward,
    FiLayers,
} from "react-icons/fi";
---

<Layout
    title="Descarga DataUMSA Collect | Aplicación Móvil"
    description="Descarga la aplicación oficial DataUMSA Collect para recolectar datos en campo de forma offline en dispositivos Android."
>
    <!-- Split Hero Section -->
    <section class="w-full py-20 md:py-32 relative overflow-hidden flex items-center justify-center">
        <!-- Luces de fondo -->
        <div class="absolute top-1/4 left-1/3 w-[600px] h-[300px] bg-primary/10 rounded-full blur-[120px] pointer-events-none -z-10 animate-pulse-slow"></div>
        <div class="absolute bottom-1/3 right-1/4 w-[400px] h-[250px] bg-accent/10 rounded-full blur-[100px] pointer-events-none -z-10"></div>

        <div class="max-w-7xl w-full mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-16 items-center relative z-10">
            <!-- Columna Izquierda: Información de Descarga -->
            <div class="lg:col-span-7 flex flex-col justify-center">
                <div class="flex items-center gap-2 mb-6">
                    <Badge variant="primary">Distribución Oficial UMSA</Badge>
                    <span class="text-xs font-mono font-bold px-2.5 py-1 rounded-full bg-slate-900 text-primary border border-primary/20">
                        Versión 3.0
                    </span>
                </div>

                <h1 class="text-text-main font-display text-4xl md:text-5xl lg:text-6xl font-black tracking-tight leading-[1.1] mb-6">
                    Lleva la recolección <br />
                    <TextReveal variant="light">
                        a tu dispositivo Android
                    </TextReveal>
                </h1>

                <p class="text-text-muted font-sans text-lg md:text-xl leading-relaxed mb-8 max-w-xl">
                    Instala la aplicación oficial{" "}
                    <strong class="text-text-main font-bold">
                        DataUMSA Collect
                    </strong>{" "}
                    en tu teléfono o tableta. Diseñada para la comunidad
                    universitaria y los equipos de investigación, permitiendo
                    trabajar de forma continua incluso sin conexión a internet.
                </p>

                <!-- Tarjeta de Descarga Directa e Institucionalización -->
                <div class="flex flex-col gap-5 max-w-xl">
                    <!-- Botón de Descarga Directa Principal -->
                    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
                        <a
                            href="/apk/DATA-UMSA-Collect-release-3.apk"
                            download="DATA-UMSA-Collect-release-3.apk"
                            class="bg-slate-950 hover:bg-slate-900 text-white rounded-2xl px-6 py-4 flex items-center justify-center sm:justify-start gap-3.5 border border-slate-800 transition-all duration-300 shadow-xl shadow-slate-950/20 active:scale-[0.98] select-none group/download"
                        >
                            <div class="w-10 h-10 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center flex-shrink-0 group-hover/download:bg-primary group-hover/download:text-white transition-all duration-300 text-primary">
                                <FiDownload className="w-5 h-5 group-hover/download:translate-y-0.5 transition-transform" />
                            </div>
                            <div class="flex flex-col items-start leading-tight">
                                <span class="text-xs font-bold tracking-widest text-slate-400 uppercase">
                                    Archivo de Instalación Directa
                                </span>
                                <span class="text-base font-bold font-sans tracking-tight text-white">
                                    Descargar DataUMSA Collect (.apk)
                                </span>
                                <span class="text-xs text-primary/90 font-mono mt-0.5">
                                    8.4 MB • Compatible con Android 5.0 o
                                    superior
                                </span>
                            </div>
                        </a>
                    </div>

                    <!-- Aviso de Institucionalización UMSA -->
                    <div class="p-4 rounded-2xl bg-slate-50/80 border border-border/80 flex items-start gap-3.5 shadow-xs">
                        <div class="w-8 h-8 rounded-lg bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-600 shrink-0 mt-0.5">
                            <FiAward className="w-4 h-4" />
                        </div>
                        <div class="flex flex-col gap-1">
                            <span class="text-xs font-bold text-text-main uppercase tracking-wider flex items-center gap-1.5">
                                Proceso de Institucionalización UMSA
                                <span class="inline-block w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                            </span>
                            <p class="text-xs text-text-muted leading-relaxed">
                                La plataforma se encuentra en proceso de
                                formalización e institucionalización en la{" "}
                                <strong>Universidad Mayor de San Andrés</strong>
                                . Una vez concluida esta etapa, la aplicación
                                estará disponible en la{" "}
                                <strong>Google Play Store</strong>. Por el
                                momento, puede instalarse de manera directa y
                                segura mediante este archivo oficial.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Columna Derecha: Mockup del Smartphone con la App Real en Ejecución -->
            <div class="lg:col-span-5 flex items-center justify-center relative">
                <!-- Smartphone Mockup -->
                <div class="w-[300px] h-[600px] rounded-[2.8rem] border-[10px] border-slate-900 bg-slate-950 shadow-[0_30px_70px_-15px_rgba(0,0,0,0.35)] p-4 relative overflow-hidden flex flex-col justify-between select-none">
                    <!-- Notch del Teléfono -->
                    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-28 h-5 bg-slate-900 rounded-b-xl z-20 flex items-center justify-center">
                        <div class="w-10 h-1 bg-white/20 rounded-full mb-1"></div>
                    </div>

                    <!-- App Bar Superior -->
                    <div class="pt-4 flex items-center justify-between border-b border-white/10 pb-3">
                        <div class="flex items-center gap-2">
                            <div class="w-6 h-6 rounded-md bg-primary/20 border border-primary/40 flex items-center justify-center">
                                <FiDatabase className="w-3.5 h-3.5 text-primary" />
                            </div>
                            <span class="text-xs font-bold text-white font-display">
                                DataUMSA Collect
                            </span>
                        </div>
                        <span class="text-xs font-mono font-bold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded-full flex items-center gap-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                            Sin conexión
                        </span>
                    </div>

                    <!-- Pantalla Principal de la App DataUMSA Collect -->
                    <div class="flex-grow py-4 flex flex-col gap-3.5 overflow-hidden">
                        <!-- Perfil / Usuario Institucional -->
                        <div class="p-3 rounded-xl bg-slate-900/90 border border-white/5 flex items-center justify-between">
                            <div class="flex flex-col">
                                <span class="text-[10px] font-mono uppercase text-slate-400 tracking-wider">
                                    Cuenta Institucional
                                </span>
                                <span class="text-xs font-bold text-white font-display">
                                    investigador@umsa.bo
                                </span>
                            </div>
                            <div class="w-6 h-6 rounded-full bg-primary/10 flex items-center justify-center text-primary text-[10px] font-bold">
                                UMSA
                            </div>
                        </div>

                        <!-- Card de Proyecto Activo -->
                        <div class="p-3.5 rounded-xl bg-gradient-to-br from-slate-900 to-slate-900/60 border border-primary/20 flex flex-col gap-2 relative overflow-hidden">
                            <div class="flex items-center justify-between">
                                <span class="text-[10px] font-bold uppercase tracking-wider text-primary font-mono">
                                    Proyecto Activo
                                </span>
                                <span class="text-[10px] text-slate-400 font-mono">
                                    v3.0
                                </span>
                            </div>
                            <span class="text-xs font-bold text-white font-display leading-snug">
                                Relevamiento Socioeconómico y Ambiental 2026
                            </span>
                            <div class="flex items-center gap-2 text-[10px] text-slate-400 pt-1 border-t border-white/5">
                                <FiMapPin className="w-3 h-3 text-primary shrink-0" />
                                <span class="font-mono">
                                    La Paz, Bolivia (GPS Activo)
                                </span>
                            </div>
                        </div>

                        <!-- Fila de Formularios Listos -->
                        <div class="flex flex-col gap-2">
                            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 font-mono">
                                Formularios Disponibles
                            </span>

                            <div class="p-2.5 rounded-lg bg-slate-900/60 border border-white/5 flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <div class="w-5 h-5 rounded bg-emerald-500/10 flex items-center justify-center text-emerald-400">
                                        <FiCheck className="w-3 h-3" />
                                    </div>
                                    <span class="text-xs font-medium text-slate-200">
                                        Ficha_Comunal_v2.xml
                                    </span>
                                </div>
                                <span class="text-[10px] font-mono text-slate-500">
                                    Disponible
                                </span>
                            </div>

                            <div class="p-2.5 rounded-lg bg-slate-900/60 border border-white/5 flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <div class="w-5 h-5 rounded bg-primary/10 flex items-center justify-center text-primary">
                                        <FiLayers className="w-3 h-3" />
                                    </div>
                                    <span class="text-xs font-medium text-slate-200">
                                        Muestreo_Agua_pH.xml
                                    </span>
                                </div>
                                <span class="text-[10px] font-mono text-slate-500">
                                    Sincronizado
                                </span>
                            </div>
                        </div>

                        <!-- Botón Acción dentro de la App -->
                        <div class="mt-auto flex flex-col gap-2">
                            <div class="w-full bg-gradient-to-r from-primary to-primary-dark text-white rounded-xl py-2.5 px-3 flex items-center justify-between shadow-lg shadow-primary/20 text-xs font-bold">
                                <span>Iniciar Nuevo Formulario</span>
                                <span class="text-sm font-bold">→</span>
                            </div>
                            <div class="flex items-center justify-between px-1 text-[10px] text-slate-500 font-mono">
                                <span class="flex items-center gap-1">
                                    <FiLock className="w-2.5 h-2.5 text-primary" />{" "}
                                    Almacenamiento Cifrado
                                </span>
                                <span>Servidor Central UMSA</span>
                            </div>
                        </div>
                    </div>

                    <!-- Footer del Teléfono -->
                    <div class="pt-2 border-t border-white/10 flex items-center justify-center">
                        <div class="w-24 h-1 bg-white/20 rounded-full"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Bento Grid Rediseñado: 1x2 con Lenguaje Formal y Natural -->
    <section class="w-full py-24 bg-slate-50/75 border-y border-border relative overflow-hidden flex flex-col items-center">
        <div class="max-w-6xl w-full mx-auto px-6 relative z-10">
            <!-- Encabezado de la Sección -->
            <div class="text-center max-w-2xl mx-auto mb-16">
                <Badge variant="primary" class="mb-4">
                    Requisitos y Características
                </Badge>
                <h2 class="text-text-main font-display text-3xl md:text-4xl lg:text-5xl font-black tracking-tight leading-tight">
                    Diseñada para el{" "}
                    <TextReveal variant="light">trabajo de campo</TextReveal>
                </h2>
                <p class="text-text-muted font-sans text-base md:text-lg mt-4">
                    Optimizada para garantizar una recolección de información
                    continua y confiable en cualquier región del país.
                </p>
            </div>

            <!-- Bento Grid 1x2: 7 Columnas (Tarjeta Principal) + 5 Columnas (2 Tarjetas Apiladas) -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
                <!-- Columna Izquierda: Tarjeta Principal (Requisitos y Compatibilidad) -->
                <div class="lg:col-span-7 glass-panel p-8 md:p-9 flex flex-col justify-between border border-border hover:shadow-xl hover:shadow-primary/5 transition-all duration-300 rounded-3xl">
                    <div class="flex flex-col gap-6">
                        <!-- Cabecera de la Tarjeta con Badges -->
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-mono font-bold uppercase tracking-wider text-primary bg-primary/10 border border-primary/20 px-3 py-1 rounded-full flex items-center gap-1.5">
                                <FiCpu className="w-3.5 h-3.5" /> Compatibilidad
                                de Sistema
                            </span>
                            <span class="text-xs font-mono font-bold text-emerald-600 bg-emerald-50 px-2.5 py-0.5 rounded-md border border-emerald-200">
                                Amplio Soporte Android
                            </span>
                        </div>

                        <!-- Indicadores Visuales de Recursos y Versión -->
                        <div class="w-full rounded-2xl bg-slate-900 border border-white/5 p-5 flex flex-col gap-4 text-white font-mono shadow-sm">
                            <div class="flex justify-between items-center text-xs">
                                <span class="text-slate-400 flex items-center gap-2">
                                    <FiSmartphone className="w-4 h-4 text-primary" />{" "}
                                    SISTEMA OPERATIVO
                                </span>
                                <span class="text-emerald-400 font-bold bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded">
                                    Android 5.0 en adelante
                                </span>
                            </div>
                            <!-- Barra de compatibilidad visual -->
                            <div class="w-full h-2 rounded-full bg-white/10 overflow-hidden">
                                <div class="w-[96%] h-full bg-gradient-to-r from-emerald-500 via-primary to-accent rounded-full"></div>
                            </div>
                            <div class="grid grid-cols-2 gap-4 pt-3 border-t border-white/5 text-xs">
                                <div class="flex flex-col">
                                    <span class="text-slate-400 text-[10px]">
                                        CONSUMO DE MEMORIA
                                    </span>
                                    <span class="text-primary font-bold text-sm">
                                        Bajo uso de recursos
                                    </span>
                                </div>
                                <div class="flex flex-col">
                                    <span class="text-slate-400 text-[10px]">
                                        TAMAÑO DE DESCARGA
                                    </span>
                                    <span class="text-emerald-400 font-bold text-sm">
                                        8.4 MB (Instalador completo)
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Título y Descripción -->
                        <div class="flex flex-col gap-2.5">
                            <h3 class="text-text-main font-display text-2xl font-bold">
                                Compatibilidad y Requisitos de Hardware
                            </h3>
                            <p class="text-text-muted font-sans text-sm md:text-base leading-relaxed">
                                Desarrollada para operar de manera estable en
                                una amplia variedad de modelos, facilitando el
                                trabajo tanto en teléfonos modernos como en
                                dispositivos de gamas anteriores utilizados por
                                brigadas y censistas en campo.
                            </p>
                        </div>
                    </div>

                    <!-- Ficha Técnica 2x2 en la Base -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-6 mt-6 border-t border-border">
                        <div class="p-3 rounded-2xl bg-slate-50/80 border border-border/80 flex flex-col">
                            <span class="text-[11px] font-bold text-text-muted uppercase">
                                Versión Mínima
                            </span>
                            <span class="text-sm font-bold text-text-main">
                                Android 5.0 (Lollipop)
                            </span>
                        </div>
                        <div class="p-3 rounded-2xl bg-emerald-50/80 border border-emerald-200/80 flex flex-col">
                            <span class="text-[11px] font-bold text-emerald-700 uppercase">
                                Versión Recomendada
                            </span>
                            <span class="text-sm font-bold text-emerald-950">
                                Android 10 o superior
                            </span>
                        </div>
                        <div class="p-3 rounded-2xl bg-slate-50/80 border border-border/80 flex flex-col">
                            <span class="text-[11px] font-bold text-text-muted uppercase">
                                Memoria RAM
                            </span>
                            <span class="text-sm font-bold text-text-main">
                                2 GB mín. (4 GB recomendada)
                            </span>
                        </div>
                        <div class="p-3 rounded-2xl bg-slate-50/80 border border-border/80 flex flex-col">
                            <span class="text-[11px] font-bold text-text-muted uppercase">
                                Modo de Operación
                            </span>
                            <span class="text-sm font-bold text-text-main">
                                Autónomo (sin conexión a internet)
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Columna Derecha: 2 Tarjetas Apiladas y Equilibradas -->
                <div class="lg:col-span-5 flex flex-col gap-8 justify-between">
                    <!-- Tarjeta 2: Ubicación Geográfica y Privacidad -->
                    <div class="glass-panel p-7 flex-1 flex flex-col justify-between border border-border hover:shadow-xl hover:shadow-accent/5 transition-all duration-300 rounded-3xl">
                        <div class="flex flex-col gap-4">
                            <!-- Visual de Sensores y Ubicación -->
                            <div class="w-full rounded-2xl bg-slate-900 border border-white/5 p-4 flex items-center justify-between text-white font-mono shadow-sm">
                                <div class="flex items-center gap-2.5">
                                    <div class="w-7 h-7 rounded-lg bg-accent/20 flex items-center justify-center text-accent">
                                        <FiMapPin className="w-4 h-4" />
                                    </div>
                                    <span class="text-xs font-bold text-white">
                                        Sensor GPS
                                    </span>
                                </div>
                                <span class="text-[10px] text-accent font-bold px-2 py-0.5 rounded bg-accent/10 border border-accent/30">
                                    Ubicación Geográfica
                                </span>
                            </div>

                            <div class="flex flex-col gap-2">
                                <h3 class="text-text-main font-display text-xl font-bold">
                                    Ubicación Geográfica y Privacidad
                                </h3>
                                <p class="text-text-muted font-sans text-sm leading-relaxed">
                                    La aplicación solicita únicamente los
                                    permisos indispensables para la recolección
                                    de datos en campo. No contiene publicidad
                                    comercial ni recopila datos personales
                                    innecesarios para el proyecto.
                                </p>
                            </div>
                        </div>

                        <ul class="space-y-1.5 text-xs text-text-muted font-bold pt-4 mt-4 border-t border-border">
                            <li class="flex items-center gap-2">
                                <FiCheck className="text-accent" /> Registro de
                                coordenadas y puntos geográficos
                            </li>
                            <li class="flex items-center gap-2">
                                <FiCheck className="text-accent" /> Captura de
                                fotografías en calidad original
                            </li>
                        </ul>
                    </div>

                    <!-- Tarjeta 3: Seguridad y Respaldo Institucional -->
                    <div class="glass-panel p-7 flex-1 flex flex-col justify-between border border-border hover:shadow-xl hover:shadow-primary/5 transition-all duration-300 rounded-3xl">
                        <div class="flex flex-col gap-4">
                            <!-- Visual de Servidor y Cifrado -->
                            <div class="w-full rounded-2xl bg-slate-900 border border-white/5 p-4 flex items-center justify-around text-white font-mono shadow-sm">
                                <div class="flex items-center gap-1.5">
                                    <FiSmartphone className="w-3.5 h-3.5 text-slate-400" />
                                    <span class="text-[10px] text-slate-300">
                                        Dispositivo Móvil
                                    </span>
                                </div>
                                <div class="flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-primary/20 border border-primary/40 text-primary text-[10px] font-bold">
                                    <FiLock className="w-3 h-3 animate-pulse" />{" "}
                                    Conexión Segura
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <FiServer className="w-3.5 h-3.5 text-slate-400" />
                                    <span class="text-[10px] text-slate-300">
                                        Servidores UMSA
                                    </span>
                                </div>
                            </div>

                            <div class="flex flex-col gap-2">
                                <h3 class="text-text-main font-display text-xl font-bold">
                                    Seguridad y Respaldo Institucional
                                </h3>
                                <p class="text-text-muted font-sans text-sm leading-relaxed">
                                    La información recolectada se transmite de
                                    forma directa a los servidores centrales de
                                    la Universidad Mayor de San Andrés,
                                    garantizando el resguardo y la custodia
                                    académica de los datos.
                                </p>
                            </div>
                        </div>

                        <ul class="space-y-1.5 text-xs text-text-muted font-bold pt-4 mt-4 border-t border-border">
                            <li class="flex items-center gap-2">
                                <FiCheck className="text-primary" />{" "}
                                Almacenamiento exclusivo en servidores
                                universitarios
                            </li>
                            <li class="flex items-center gap-2">
                                <FiCheck className="text-primary" /> Transmisión
                                protegida mediante canales cifrados
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Guía de Instalación de la Aplicación (3 Pasos Claros) -->
    <section class="w-full py-24 relative overflow-hidden flex flex-col items-center">
        <div class="max-w-5xl w-full mx-auto px-6 relative z-10">
            <!-- Encabezado de la sección -->
            <div class="text-center max-w-2xl mx-auto mb-20">
                <Badge variant="primary" class="mb-4">
                    Guía de Instalación
                </Badge>
                <h2 class="text-text-main font-display text-3xl md:text-4xl lg:text-5xl font-black tracking-tight leading-tight">
                    ¿Cómo instalar la aplicación{" "}
                    <TextReveal variant="light">en su dispositivo?</TextReveal>
                </h2>
                <p class="text-text-muted font-sans text-base md:text-lg mt-4">
                    Siga estos tres sencillos pasos para instalar y comenzar a
                    utilizar la aplicación en su teléfono o tableta.
                </p>
            </div>

            <!-- Grid de 3 Pasos Reales para APK -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
                <!-- Paso 1: Descargar -->
                <div class="glass-panel p-8 flex flex-col justify-between border border-border hover:border-primary/30 transition-all duration-300 group rounded-3xl">
                    <div class="flex flex-col gap-6">
                        <div class="w-full h-24 rounded-2xl bg-slate-900 border border-white/5 flex flex-col justify-between p-4 relative overflow-hidden shadow-sm">
                            <div class="flex justify-between items-center text-xs font-mono text-slate-400">
                                <span class="text-primary font-bold flex items-center gap-1.5">
                                    <FiDownload className="w-3.5 h-3.5 animate-bounce" />{" "}
                                    DESCARGA DIRECTA
                                </span>
                                <span class="text-white font-bold">8.4 MB</span>
                            </div>
                            <div class="w-full h-1.5 rounded-full bg-white/10 overflow-hidden">
                                <div class="h-full bg-primary rounded-full animate-[loading-bar_3s_infinite_linear]"></div>
                            </div>
                            <span class="text-[10px] text-slate-400 font-mono">
                                DATA-UMSA-Collect-release-3.apk
                            </span>
                        </div>

                        <div class="flex flex-col gap-2.5">
                            <div class="w-8 h-8 rounded-xl bg-primary/10 text-primary-dark font-mono font-bold text-sm flex items-center justify-center">
                                1
                            </div>
                            <h3 class="text-text-main font-display text-lg font-bold">
                                Descargar el archivo
                            </h3>
                            <p class="text-text-muted font-sans text-sm leading-relaxed">
                                Presione el botón de descarga en esta página
