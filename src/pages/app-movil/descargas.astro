---
import Layout from '../../layouts/Layout.astro';
import Badge from '../../components/components-astro/Badge.astro';
import TextReveal from '../../components/components-astro/TextReveal.astro';
import { 
    FiDownload, 
    FiSearch, 
    FiInfo, 
    FiSmartphone, 
    FiDatabase, 
    FiAlertTriangle,
    FiCpu,
    FiCheck,
    FiStar,
    FiShield,
    FiLock,
    FiServer,
    FiSettings,
    FiCamera,
    FiMapPin
} from "react-icons/fi";
---

<Layout title="Descarga DataUMSA Collect | Aplicación Móvil" description="Descarga la aplicación oficial DataUMSA Collect para recolectar datos en campo de forma offline en dispositivos Android.">

<!-- Split Hero Section -->
<section class="w-full py-20 md:py-32 relative overflow-hidden flex items-center justify-center">
    <!-- Luces de fondo -->
    <div class="absolute top-1/4 left-1/3 w-[600px] h-[300px] bg-primary/10 rounded-full blur-[120px] pointer-events-none -z-10 animate-pulse-slow"></div>

    <div class="max-w-7xl w-full mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-16 items-center relative z-10">
        
        <!-- Columna Izquierda: Información de Descarga -->
        <div class="lg:col-span-7 flex flex-col justify-center">
            <Badge variant="primary" class="mb-6 self-start">
                Descarga Oficial
            </Badge>
            <h1 class="text-text-main font-display text-4xl md:text-5xl lg:text-6xl font-black tracking-tight leading-[1.1] mb-6">
                Lleva la recolección <br />
                <TextReveal variant="light">a tu dispositivo Android</TextReveal>
            </h1>
            <p class="text-text-muted font-sans text-lg md:text-xl leading-relaxed mb-8 max-w-xl">
                Instala la aplicación oficial **DataUMSA Collect** de forma gratuita en tu celular o tablet. Sencilla, robusta y optimizada para operar sin conexión a internet en los escenarios de campo más complejos.
            </p>
            
            <!-- Botón Oficial Google Play Badge en CSS -->
            <div class="flex flex-col gap-4">
                <a 
                    href="#" 
                    class="self-start bg-slate-950 hover:bg-slate-900 text-white rounded-2xl px-6 py-3.5 flex items-center gap-3 border border-slate-800 transition-colors shadow-lg shadow-primary/5 select-none group/play"
                >
                    <!-- Logotipo del triángulo de colores de Google Play en CSS -->
                    <div class="w-6 h-6 relative flex items-center justify-center flex-shrink-0 group-hover/play:scale-105 transition-transform">
                        <svg class="w-full h-full" viewBox="0 0 24 24" fill="none">
                            <path d="M3 2.5v19c0 .5.3.8.7.9l10-10L3.7 1.6c-.4.1-.7.4-.7.9z" fill="#EA4335" />
                            <path d="M17.5 12l-3.8-3.8-10 10c.2.2.5.2.8.1l13-6.3z" fill="#FBBC05" />
                            <path d="M17.5 12l-13-6.3c-.3-.1-.6-.1-.8.1l10 10 3.8-3.8z" fill="#4285F4" />
                            <path d="M21 10.3l-3.5 1.7 3.5 1.7c.6-.3 1-.9 1-1.7s-.4-1.4-1-1.7z" fill="#34A853" />
                        </svg>
                    </div>
                    <div class="flex flex-col items-start leading-none">
                        <span class="text-[9px] font-bold tracking-widest text-slate-400 uppercase">Disponible en</span>
                        <span class="text-lg font-bold font-sans tracking-tight">Google Play</span>
                    </div>
                </a>
                <p class="text-xs text-text-muted font-medium italic">
                    * Próximamente disponible con ícono y banner oficial en la Google Play Store.
                </p>
            </div>
        </div>
        
        <!-- Columna Derecha: Mockup de la Play Store en Smartphone -->
        <div class="lg:col-span-5 flex items-center justify-center relative">
            <!-- Smartphone Mockup -->
            <div class="w-[290px] h-[580px] rounded-[2.5rem] border-[10px] border-slate-900 bg-white shadow-[0_25px_60px_-15px_rgba(0,0,0,0.2)] p-4 relative overflow-hidden flex flex-col justify-between">
                <!-- Notch del Teléfono -->
                <div class="absolute top-0 left-1/2 -translate-x-1/2 w-28 h-5 bg-slate-900 rounded-b-xl z-20 flex items-center justify-center">
                    <div class="w-10 h-1 bg-white/20 rounded-full mb-1"></div>
                </div>

                <!-- Google Play Bar superior -->
                <div class="pt-4 flex items-center gap-3 border-b border-border pb-3">
                    <FiSearch class="w-4 h-4 text-slate-400 flex-shrink-0" />
                    <span class="text-xs font-sans text-slate-400">Buscar aplicaciones...</span>
                </div>

                <!-- Detalle de Ficha de Aplicación en la Play Store -->
                <div class="flex-grow py-4 flex flex-col gap-4 overflow-y-auto max-h-[350px] scrollbar-none">
                    <div class="flex gap-4 items-center">
                        <!-- Icono de la App Diseñado en CSS -->
                        <div class="w-16 h-16 rounded-xl bg-gradient-to-br from-primary via-primary-dark to-accent flex items-center justify-center shadow-md relative overflow-hidden flex-shrink-0">
                            <div class="absolute inset-0.5 rounded-[calc(0.75rem-2px)] bg-[#f8fafc] flex items-center justify-center">
                                <FiDatabase class="w-7 h-7 text-primary-dark" strokeWidth={2.5} />
                            </div>
                        </div>
                        
                        <div class="flex flex-col">
                            <h2 class="text-base font-bold text-text-main font-display leading-none mb-1">
                                DataUMSA Collect
                            </h2>
                            <span class="text-[10px] font-semibold text-primary-dark mb-1.5">Universidad Mayor de San Andrés</span>
                            <span class="text-[9px] font-bold text-emerald-600 bg-emerald-50 border border-emerald-100 px-2 py-0.5 rounded-md self-start">Instalada</span>
                        </div>
                    </div>

                    <!-- Datos de Calificación, Descargas e Información -->
                    <div class="grid grid-cols-3 border-y border-border py-2.5 my-1 text-center">
                        <div class="flex flex-col items-center border-r border-border">
                            <span class="text-xs font-black text-text-main flex items-center gap-0.5">
                                5.0 <FiStar class="w-3 h-3 text-amber-500 fill-current" />
                            </span>
                            <span class="text-[8px] text-text-muted font-bold uppercase">Calificación</span>
                        </div>
                        <div class="flex flex-col items-center border-r border-border">
                            <span class="text-xs font-black text-text-main">1,000+</span>
                            <span class="text-[8px] text-text-muted font-bold uppercase">Descargas</span>
                        </div>
                        <div class="flex flex-col items-center">
                            <span class="text-xs font-black text-text-main">12 MB</span>
                            <span class="text-[8px] text-text-muted font-bold uppercase">Tamaño</span>
                        </div>
                    </div>

                    <!-- Botones de Acción de Google Play -->
                    <div class="grid grid-cols-2 gap-2">
                        <span class="border border-emerald-500 text-emerald-600 text-[10px] font-bold py-2 rounded-lg text-center cursor-default bg-emerald-50/10">Desinstalar</span>
                        <span class="bg-emerald-600 text-white text-[10px] font-bold py-2 rounded-lg text-center cursor-default shadow-sm hover:bg-emerald-700 animate-pulse">Abrir</span>
                    </div>

                    <!-- Capturas de pantalla flotantes en miniatura -->
                    <div class="flex gap-2 overflow-x-auto pt-2 scrollbar-none">
                        <div class="w-20 aspect-[9/16] rounded-md bg-slate-100 border border-border flex-shrink-0 p-1 flex flex-col justify-between">
                            <div class="w-full h-1 bg-slate-300 rounded-xs"></div>
                            <div class="w-2/3 h-1 bg-slate-200 rounded-xs"></div>
                            <div class="w-full h-8 bg-primary/10 rounded-sm border border-primary/20 mt-auto"></div>
                        </div>
                        <div class="w-20 aspect-[9/16] rounded-md bg-slate-100 border border-border flex-shrink-0 p-1 flex flex-col justify-between">
                            <div class="w-full h-1.5 bg-slate-300 rounded-xs"></div>
                            <div class="w-full h-3 bg-primary/10 rounded-sm border border-primary/20"></div>
                            <div class="w-full h-6 bg-slate-200 rounded-xs mt-auto"></div>
                        </div>
                        <div class="w-20 aspect-[9/16] rounded-md bg-slate-100 border border-border flex-shrink-0 p-1"></div>
                    </div>
                </div>

                <!-- Google Play Footer -->
                <div class="pt-3 border-t border-border flex justify-center">
                    <span class="text-[9px] text-slate-400 font-medium">Verificado por Play Protect</span>
                </div>
            </div>
        </div>
        
    </div>
</section>

<!-- Bento Grid de Requisitos, Permisos y Seguridad -->
<section class="w-full py-24 bg-slate-50/75 border-y border-border relative overflow-hidden flex flex-col items-center">
    <div class="max-w-6xl w-full mx-auto px-6 relative z-10">
        
        <!-- Bento Grid Layout -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
            
            <!-- Tarjeta 1: Requisitos de Hardware (Fieles a ODK Collect) -->
            <div class="glass-panel p-8 flex flex-col justify-between border border-border hover:shadow-xl hover:shadow-primary/5 transition-all duration-300">
                <div class="flex flex-col gap-6">
                    <!-- Dashboard CSS de Hardware -->
                    <div class="w-full h-28 rounded-xl bg-slate-900 border border-white/5 p-4 flex flex-col justify-between text-white font-mono">
                        <div class="flex justify-between items-center text-[10px]">
                            <span class="text-slate-400">RAM MÍNIMA</span>
                            <span class="text-primary font-bold">2.0 GB / 4.0 GB (REC)</span>
                        </div>
                        <div class="w-full h-2 rounded-full bg-white/10 overflow-hidden">
                            <div class="w-1/2 h-full bg-primary rounded-full"></div>
                        </div>
                        <div class="flex justify-between items-center text-[10px]">
                            <span class="text-slate-400">ANDROID S.O.</span>
                            <span class="text-emerald-400 font-bold">8.0 (MIN) / 10+ (REC)</span>
                        </div>
                    </div>
                    
                    <div class="flex flex-col gap-3">
                        <h3 class="text-text-main font-display text-xl font-bold">Requisitos de Hardware</h3>
                        <p class="text-text-muted font-sans text-sm leading-relaxed">
                            Al ser un fork directo del motor de **ODK Collect**, el rendimiento depende de la complejidad del formulario.
                        </p>
                        <ul class="space-y-1 text-xs text-text-muted font-bold">
                            <li class="flex justify-between pb-1.5 border-b border-border">
                                <span>Almacenamiento</span>
                                <span class="text-text-main">1.0 GB recomendado</span>
                            </li>
                            <li class="flex justify-between">
                                <span>Batería</span>
                                <span class="text-text-main">2,500 mAh mínimo</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Tarjeta 2: Permisos del Dispositivo (Diseño Interactiva de Popup) -->
            <div class="glass-panel p-8 flex flex-col justify-between border border-border hover:shadow-xl hover:shadow-accent/5 transition-all duration-300">
                <div class="flex flex-col gap-6">
                    <!-- Popup CSS de Android Permisos -->
                    <div class="w-full h-28 rounded-xl bg-white border border-border p-3.5 flex flex-col justify-between shadow-xs">
                        <div class="flex items-center gap-2">
                            <div class="w-6 h-6 rounded-full bg-accent/10 flex items-center justify-center text-accent-dark">
                                <FiMapPin class="w-3.5 h-3.5" />
                            </div>
                            <span class="text-[9px] font-bold text-text-main">¿Permitir acceso a la ubicación?</span>
                        </div>
                        <p class="text-[8px] text-text-muted leading-tight">
                            DataUMSA Collect requiere este permiso para georreferenciar las encuestas en campo de forma precisa.
                        </p>
                        <div class="flex gap-1.5 justify-end text-[8px] font-bold">
                            <span class="bg-accent text-white px-2 py-1 rounded-sm shadow-xs">Permitir</span>
                            <span class="border border-border text-text-muted px-2 py-1 rounded-sm">Denegar</span>
                        </div>
                    </div>
                    
                    <div class="flex flex-col gap-3">
                        <h3 class="text-text-main font-display text-xl font-bold">Permisos de Sistema</h3>
                        <p class="text-text-muted font-sans text-sm leading-relaxed">
                            La aplicación requiere permisos específicos para poder capturar datos de alta fidelidad científica en campo:
                        </p>
                        <ul class="space-y-1 text-xs text-text-muted font-bold">
                            <li class="flex items-center gap-2"><FiCheck class="text-accent" /> GPS (Ubicación de encuestas)</li>
                            <li class="flex items-center gap-2"><FiCheck class="text-accent" /> Cámara (Fotografías de respaldo)</li>
                            <li class="flex items-center gap-2"><FiCheck class="text-accent" /> Almacenamiento local (Base offline)</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Tarjeta 3: Conexión Segura (Diseño de Servidor y Escudo) -->
            <div class="glass-panel p-8 flex flex-col justify-between border border-border hover:shadow-xl hover:shadow-warning/5 transition-all duration-300">
                <div class="flex flex-col gap-6">
                    <!-- Servidor Cifrado en CSS -->
                    <div class="w-full h-28 rounded-xl bg-slate-900 border border-white/5 p-4 flex items-center justify-around relative overflow-hidden">
                        <div class="absolute inset-0 bg-gradient-to-br from-warning/10 to-transparent"></div>
                        <div class="flex flex-col gap-1 items-center z-10">
                            <FiSmartphone class="w-6 h-6 text-white" />
                            <span class="text-[7px] text-slate-400 font-mono">App</span>
                        </div>
                        <div class="flex flex-col items-center justify-center relative z-10">
                            <FiShield class="w-8 h-8 text-warning animate-pulse" />
                            <FiLock class="w-3.5 h-3.5 text-white absolute" />
                        </div>
                        <div class="flex flex-col gap-1 items-center z-10">
                            <FiServer class="w-6 h-6 text-white" />
                            <span class="text-[7px] text-slate-400 font-mono">UMSA API</span>
                        </div>
                    </div>
                    
                    <div class="flex flex-col gap-3">
                        <h3 class="text-text-main font-display text-xl font-bold">Conexión y Soberanía</h3>
                        <p class="text-text-muted font-sans text-sm leading-relaxed">
                            DataUMSA Collect está configurada para conectarse **de forma exclusiva y automática** a la API universitaria. Esto garantiza que la información nunca pase por servidores comerciales de terceros, manteniendo el control absoluto de tus datos de investigación.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- Guía de Instalación Rápida (Rediseñada con Ilustraciones Animadas en CSS) -->
<section class="w-full py-24 relative overflow-hidden flex flex-col items-center">
    <div class="max-w-5xl w-full mx-auto px-6 relative z-10">
        
        <!-- Encabezado de la sección -->
        <div class="text-center max-w-2xl mx-auto mb-24">
            <Badge variant="primary" class="mb-4">
                Pasos
            </Badge>
            <h2 class="text-text-main font-display text-3xl md:text-4xl lg:text-5xl font-black tracking-tight leading-tight">
                Instrucciones de <TextReveal variant="light">Instalación</TextReveal>
            </h2>
            <p class="text-text-muted font-sans text-base md:text-lg mt-4">
                Sigue esta guía interactiva para comenzar a recolectar información en minutos.
            </p>
        </div>
        
        <!-- Grid de Pasos Rediseñado -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
            
            <!-- Paso 1: Buscar -->
            <div class="glass-panel p-8 flex flex-col justify-between border border-border hover:border-primary/30 transition-all duration-300 group">
                <div class="flex flex-col gap-6">
                    <!-- Ilustración CSS: Barra de búsqueda simulada escribiendo -->
                    <div class="w-full h-20 rounded-xl bg-slate-900 border border-white/5 flex items-center px-4 gap-3 relative overflow-hidden shadow-sm">
                        <FiSearch class="text-slate-400 w-4 h-4 flex-shrink-0 animate-pulse" />
                        <div class="flex items-center gap-0.5 text-xs text-white font-mono overflow-hidden whitespace-nowrap">
                            <span class="animate-[typing_4s_steps(16)_infinite] overflow-hidden whitespace-nowrap inline-block">DataUMSA Collect</span>
                            <span class="w-1 h-3.5 bg-white animate-[caret_1s_infinite]"></span>
                        </div>
                    </div>

                    <div class="flex flex-col gap-3">
                        <div class="w-8 h-8 rounded-full bg-primary/10 text-primary-dark font-mono font-bold text-sm flex items-center justify-center">
                            1
                        </div>
                        <h3 class="text-text-main font-display text-lg font-bold">Busca en la Play Store</h3>
                        <p class="text-text-muted font-sans text-sm leading-relaxed font-medium">
                            Abre la Google Play Store en tu celular y escribe **"DataUMSA Collect"** en la barra de búsqueda superior.
                        </p>
                    </div>
                </div>
            </div>
            
            <!-- Paso 2: Instalar -->
            <div class="glass-panel p-8 flex flex-col justify-between border border-border hover:border-primary/30 transition-all duration-300 group">
                <div class="flex flex-col gap-6">
                    <!-- Ilustración CSS: Descarga activa -->
                    <div class="w-full h-20 rounded-xl bg-slate-900 border border-white/5 flex flex-col justify-between p-4 relative overflow-hidden shadow-sm">
                        <div class="flex justify-between items-center text-[9px] font-mono text-slate-400">
                            <span class="animate-pulse">DESCARGANDO...</span>
                            <span class="text-primary font-bold">12.4 MB</span>
                        </div>
                        <div class="w-full h-1.5 rounded-full bg-white/10 overflow-hidden">
                            <div class="h-full bg-primary rounded-full animate-[loading-bar_3s_infinite_linear]"></div>
                        </div>
                    </div>

                    <div class="flex flex-col gap-3">
                        <div class="w-8 h-8 rounded-full bg-primary/10 text-primary-dark font-mono font-bold text-sm flex items-center justify-center">
                            2
                        </div>
                        <h3 class="text-text-main font-display text-lg font-bold">Instala la App</h3>
                        <p class="text-text-muted font-sans text-sm leading-relaxed font-medium">
                            Presiona el botón verde de **"Instalar"** y el dispositivo descargará el software en segundo plano.
                        </p>
                    </div>
                </div>
            </div>
            
            <!-- Paso 3: Vincular -->
            <div class="glass-panel p-8 flex flex-col justify-between border border-border hover:border-primary/30 transition-all duration-300 group">
                <div class="flex flex-col gap-6">
                    <!-- Ilustración CSS: Login exitoso -->
                    <div class="w-full h-20 rounded-xl bg-slate-900 border border-white/5 flex items-center justify-center gap-3 relative overflow-hidden shadow-sm">
                        <div class="w-8 h-8 rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 animate-[pulse-check_2s_infinite]">
                            <FiCheck class="w-4 h-4" />
                        </div>
                        <span class="text-[10px] text-white font-mono font-bold tracking-wider">Sesión Iniciada</span>
                    </div>

                    <div class="flex flex-col gap-3">
                        <div class="w-8 h-8 rounded-full bg-primary/10 text-primary-dark font-mono font-bold text-sm flex items-center justify-center">
                            3
                        </div>
                        <h3 class="text-text-main font-display text-lg font-bold">Vincula tu Cuenta</h3>
                        <p class="text-text-muted font-sans text-sm leading-relaxed font-medium">
                            Abre la aplicación e introduce tu correo institucional y contraseña de DataUMSA para sincronizar tus formularios.
                        </p>
                    </div>
                </div>
            </div>

        </div>
        
    </div>
</section>

</Layout>

<style>
    /* Estilos extras y reseteo de barra de scroll para el mockup */
    .scrollbar-none::-webkit-scrollbar {
        display: none;
    }
    .scrollbar-none {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
    
    /* Animaciones exclusivas del rediseño */
    .animate-pulse-slow {
        animation: pulse-glow 8s ease-in-out infinite alternate;
    }
    @keyframes pulse-glow {
        0% {
            opacity: 0.3;
            transform: scale(0.95);
        }
        100% {
            opacity: 0.7;
            transform: scale(1.05);
        }
    }

    /* Animación de escribir texto */
    @keyframes typing {
        0%, 10% { width: 0; }
        70%, 100% { width: 100px; }
    }

    /* Cursor parpadeante */
    @keyframes caret {
        from, to { background-color: transparent }
        50% { background-color: white }
    }

    /* Barra de carga */
    @keyframes loading-bar {
        0% { width: 0%; }
        80%, 100% { width: 100%; }
    }

    /* Parpadeo del check de éxito */
    @keyframes pulse-check {
        0%, 100% { transform: scale(1); opacity: 0.8; }
        50% { transform: scale(1.15); opacity: 1; }
    }
</style>
