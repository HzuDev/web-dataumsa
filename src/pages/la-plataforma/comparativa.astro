---
import Layout from '../../layouts/Layout.astro';
import Badge from '../../components/components-astro/Badge.astro';
import TextReveal from '../../components/components-astro/TextReveal.astro';
import { 
    FiShield, 
    FiWifiOff, 
    FiLayers, 
    FiPieChart, 
    FiDollarSign, 
    FiAward,
    FiX,
    FiMinus,
    FiCheck,
    FiCode,
    FiDatabase,
    FiMapPin,
    FiCamera,
    FiActivity,
    FiLock
} from "react-icons/fi";

// Datos de la tabla comparativa
const features = [
    {
        aspect: "Privacidad y propiedad",
        icon: FiShield,
        google: { text: "Tus datos se monetizan", state: "danger" },
        umsa: { text: "100% bajo control UMSA", state: "success" }
    },
    {
        aspect: "Trabajo en campo",
        icon: FiWifiOff,
        google: { text: "Requiere conexión", state: "danger" },
        umsa: { text: "App nativa offline", state: "success" }
    },
    {
        aspect: "Lógica de formularios",
        icon: FiLayers,
        google: { text: "Saltos básicos", state: "warning" },
        umsa: { text: "Avanzado (XLSForm)", state: "success" }
    },
    {
        aspect: "Análisis científico",
        icon: FiPieChart,
        google: { text: "Solo Google Sheets", state: "danger" },
        umsa: { text: "R, Python, SPSS, Stata", state: "success" }
    },
    {
        aspect: "Funciones avanzadas",
        icon: FiDollarSign,
        google: { text: "Limitadas o de pago", state: "warning" },
        umsa: { text: "Completamente gratis", state: "success" }
    }
];

const stateClasses: Record<string, string> = {
  danger: "text-danger-dark",
  warning: "text-warning-dark",
  success: "text-success-dark"
};
---

<Layout title="Comparativa" description="Descubre por qué DataUMSA es la alternativa superior a Google Forms y otras herramientas comerciales para la investigación académica.">

<!-- 1. Hero & Tabla Comparativa -->
<section class="w-full py-20 md:py-28 relative overflow-hidden flex flex-col items-center bg-glow-container">
    <div class="w-full max-w-5xl mx-auto px-6 relative z-10">
        
        <div class="flex flex-col items-center text-center mb-16">
            <Badge variant="primary" class="mb-6">
                Análisis de Herramientas
            </Badge>
            <h1 class="text-text-main font-display text-4xl md:text-5xl lg:text-6xl font-black tracking-tight leading-[1.1] mb-6">
                Más allá de las <span class="text-reveal-light">encuestas básicas</span>
            </h1>
            <p class="text-text-muted font-sans text-lg md:text-xl max-w-2xl font-medium leading-relaxed">
                Por costumbre, la universidad ha utilizado herramientas comerciales para proyectos serios. Descubre por qué el rigor científico exige una infraestructura especializada.
            </p>
        </div>

        <!-- Panel Contenedor de la Tabla -->
        <div class="glass-panel w-full p-4 md:p-8 overflow-hidden relative mb-12">
            
            <div class="grid grid-cols-12 gap-4 items-end px-2 md:px-4 mb-6 border-b border-border pb-6">
                <div class="col-span-4 text-xs font-bold uppercase tracking-widest text-text-muted">
                    Característica
                </div>
                <div class="col-span-4 text-center font-bold text-sm md:text-base opacity-60 text-text-main font-display">
                    Alternativas Comerciales
                </div>
                <div class="col-span-4 flex flex-col items-center justify-center">
                    <div class="relative flex items-center justify-center w-8 h-8 mb-2">
                        <div class="absolute inset-0 rounded-full bg-primary/20 animate-ping" style="animation-duration: 3s;"></div>
                        <div class="relative w-3 h-3 rounded-full bg-primary-dark shadow-[0_0_10px_rgba(41,185,242,0.6)]"></div>
                    </div>
                    <span class="text-lg md:text-2xl font-black text-primary-dark font-display">
                        DataUMSA
                    </span>
                </div>
            </div>

            <div class="flex flex-col">
                {features.map((item, index) => {
                    const Icon = item.icon;
                    const isLast = index === features.length - 1;
                    const googleColor = stateClasses[item.google.state] || "text-text-muted";
                    return (
                        <div class={`grid grid-cols-12 gap-4 items-center px-2 md:px-4 py-5 transition-colors hover:bg-slate-50/50 ${!isLast ? 'border-b border-border' : ''} group`}>
                            
                            <!-- Aspecto -->
                            <div class="col-span-4 flex items-center gap-3">
                                <div class="hidden lg:flex p-2 rounded-[var(--radius-md)] bg-white text-text-muted group-hover:text-primary-dark border border-border transition-colors">
                                    <Icon className="w-4 h-4" />
                                </div>
                                <span class="text-text-main font-bold text-sm md:text-[1.05rem] leading-tight">
                                    {item.aspect}
                                </span>
                            </div>

                            <!-- Celda Google/Otros -->
                            <div class="col-span-4 flex justify-center">
                                <div class={`flex flex-col md:flex-row items-center justify-center gap-1.5 text-xs md:text-sm font-medium text-center ${googleColor}`}>
                                    {item.google.state === 'danger' && <FiX className="w-4 h-4 opacity-70" />}
                                    {item.google.state === 'warning' && <FiMinus className="w-4 h-4 opacity-70" />}
                                    <span class="opacity-80">{item.google.text}</span>
                                </div>
                            </div>

                            <!-- Celda DataUMSA -->
                            <div class="col-span-4 flex justify-center relative">
                                <div class="absolute inset-y-[-1rem] inset-x-0 bg-primary-light/30 rounded-[var(--radius-md)] -z-10 group-hover:bg-primary-light/60 transition-colors"></div>
                                <div class="flex flex-col md:flex-row items-center justify-center gap-1.5 text-xs md:text-sm font-bold text-center text-success-dark">
                                    <FiCheck className="w-4 h-4 md:w-5 md:h-5 flex-shrink-0" strokeWidth={3} />
                                    <span>{item.umsa.text}</span>
                                </div>
                            </div>

                        </div>
                    );
                })}
            </div>
        </div>
    </div>
</section>

<!-- 2. Soberanía y Privacidad -->
<section class="w-full py-20 bg-slate-50 border-y border-border">
    <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
        <div>
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-slate-200 text-primary-dark mb-6">
                <FiLock className="w-6 h-6" />
            </div>
            <h2 class="text-3xl md:text-4xl font-display font-black text-text-main mb-6 leading-tight">
                Tus datos no son moneda de cambio
            </h2>
            <p class="text-text-muted font-sans text-lg mb-6 leading-relaxed">
                Seamos realistas: las plataformas comerciales gratuitas se financian recopilando, analizando y utilizando información para su propio beneficio. Utilizar infraestructura de terceros para investigaciones universitarias pone en riesgo la confidencialidad del estudio.
            </p>
            <p class="text-text-muted font-sans text-lg leading-relaxed">
                <strong class="text-text-main">DataUMSA opera bajo el principio de soberanía informática.</strong> Toda la información recolectada se almacena en servidores gestionados y asegurados localmente. Nadie fuera de tu equipo de investigación tiene acceso a la data.
            </p>
        </div>
        <div class="relative w-full h-[400px] rounded-[var(--radius-lg)] bg-slate-900 border border-slate-800 p-8 flex flex-col justify-between overflow-hidden shadow-2xl">
            <!-- Patrón de fondo tecnológico CSS -->
            <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(#475569 1px, transparent 1px); background-size: 24px 24px;"></div>
            
            <div class="relative z-10 flex items-center justify-between border-b border-slate-800 pb-4">
                <span class="font-mono text-xs text-slate-400">STATUS: PROTECTED</span>
                <div class="flex gap-2">
                    <span class="w-2 h-2 rounded-full bg-success"></span>
                    <span class="w-2 h-2 rounded-full bg-slate-700"></span>
                    <span class="w-2 h-2 rounded-full bg-slate-700"></span>
                </div>
            </div>
            
            <div class="relative z-10 text-center flex flex-col items-center justify-center flex-grow">
                <FiDatabase className="w-16 h-16 text-primary mb-4" />
                <h3 class="text-white font-display font-bold text-xl mb-2">Servidor UMSA Aislado</h3>
                <p class="text-slate-400 font-mono text-sm">Cifrado Extremo a Extremo</p>
            </div>
        </div>
    </div>
</section>

<!-- 3. Lógica Avanzada XLSForm -->
<section class="w-full py-24 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <h2 class="text-3xl md:text-4xl font-display font-black text-text-main mb-6 leading-tight">
                El verdadero poder está en la <span class="text-reveal-light">Lógica</span>
            </h2>
            <p class="text-text-muted font-sans text-lg leading-relaxed">
                Mientras las herramientas comunes se limitan a "ir a la siguiente sección", DataUMSA utiliza el estándar <strong class="text-primary-dark font-bold">XLSForm</strong>, permitiendo validaciones y cálculos a nivel de programación para evitar errores de captura.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Bento 1 -->
            <div class="glass-panel p-8">
                <FiCode className="w-8 h-8 text-primary-dark mb-4" />
                <h3 class="text-lg font-bold font-display text-text-main mb-3">Validación con Expresiones Regulares</h3>
                <p class="text-sm text-text-muted leading-relaxed">
                    Fuerza formatos específicos. Verifica automáticamente que un carnet, correo o código de matrícula esté escrito correctamente antes de permitir avanzar.
                </p>
            </div>
            <!-- Bento 2 -->
            <div class="glass-panel p-8">
                <FiLayers className="w-8 h-8 text-primary-dark mb-4" />
                <h3 class="text-lg font-bold font-display text-text-main mb-3">Saltos Condicionales Anidados</h3>
                <p class="text-sm text-text-muted leading-relaxed">
                    Crea árboles lógicos complejos. Muestra u oculta preguntas basándote en la combinación de múltiples respuestas previas del encuestado.
                </p>
            </div>
            <!-- Bento 3 -->
            <div class="glass-panel p-8">
                <FiActivity className="w-8 h-8 text-primary-dark mb-4" />
                <h3 class="text-lg font-bold font-display text-text-main mb-3">Cálculos en Segundo Plano</h3>
                <p class="text-sm text-text-muted leading-relaxed">
                    Suma valores, calcula edades a partir de fechas de nacimiento o genera puntajes automáticos (scores) sin que el encuestador tenga que hacer matemáticas en campo.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- 4. Trabajo de Campo (Comparativa con Freemium) -->
<section class="w-full py-24 bg-slate-900 text-white border-y border-slate-800">
    <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
        
        <div class="lg:col-span-5 flex justify-center">
            <!-- Representación UI Móvil -->
            <div class="w-full max-w-sm rounded-[2rem] border-8 border-slate-800 bg-slate-950 p-6 shadow-2xl relative">
                <div class="w-32 h-6 bg-slate-800 rounded-b-xl absolute top-0 left-1/2 -translate-x-1/2"></div>
                
                <div class="flex flex-col gap-4 mt-6">
                    <div class="w-full bg-slate-900 rounded-xl p-4 border border-slate-800">
                        <div class="flex items-center gap-3 mb-2">
                            <FiMapPin className="text-primary" />
                            <span class="text-sm font-bold">Captura GPS (Offline)</span>
                        </div>
                        <div class="w-full h-2 bg-slate-800 rounded-full mt-3">
                            <div class="w-full h-full bg-success rounded-full"></div>
                        </div>
                    </div>

                    <div class="w-full bg-slate-900 rounded-xl p-4 border border-slate-800">
                        <div class="flex items-center gap-3 mb-2">
                            <FiCamera className="text-primary" />
                            <span class="text-sm font-bold">Fotografía con Firma</span>
                        </div>
                        <div class="w-full h-2 bg-slate-800 rounded-full mt-3">
                            <div class="w-full h-full bg-success rounded-full"></div>
                        </div>
                    </div>
                    
                    <div class="w-full bg-slate-900 rounded-xl p-4 border border-primary-dark/30 bg-primary-dark/10">
                        <div class="flex items-center gap-2 justify-center py-2 text-primary">
                            <FiCheck className="w-5 h-5" />
                            <span class="text-sm font-bold">Sin restricciones premium</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="lg:col-span-7">
            <Badge variant="primary" class="mb-4 bg-primary-dark/20 text-primary border-primary-dark/30">
                DataUMSA Collect
            </Badge>
            <h2 class="text-3xl md:text-4xl font-display font-black text-white mb-6 leading-tight">
                El trabajo de campo no tiene conexión a internet. <br/> <span class="text-slate-400">Ni debería requerir una suscripción.</span>
            </h2>
            <p class="text-slate-300 font-sans text-lg mb-6 leading-relaxed">
                Alternativas de encuestas móviles como <em>SurveyHeart</em> son populares, pero esconden funciones esenciales para la investigación (como lógicas avanzadas o recolección de metadatos) detrás de barreras de pago premium.
            </p>
            <p class="text-slate-300 font-sans text-lg leading-relaxed">
                Nuestra aplicación nativa te permite encuestar en comunidades rurales totalmente <strong class="text-white">fuera de línea</strong>. Captura coordenadas geográficas satelitales, audios del entorno, firmas digitales y escanea códigos de barra. Cuando vuelvas a tener señal, los datos se sincronizan automáticamente con la universidad, sin pagar licencias.
            </p>
        </div>
        
    </div>
</section>

<!-- 5. Ecosistema Científico -->
<section class="w-full py-24 relative overflow-hidden flex flex-col items-center">
    <div class="max-w-4xl mx-auto px-6 text-center">
        <h2 class="text-3xl md:text-4xl font-display font-black text-text-main mb-6 leading-tight">
            Preparado para el análisis de <span class="text-reveal-light">Ciencia de Datos</span>
        </h2>
        <p class="text-text-muted font-sans text-lg leading-relaxed mb-12">
            No te limites a exportar en hojas de cálculo. DataUMSA genera bases de datos estructuradas y etiquetadas listas para ser ingeridas directamente por el software estadístico que utilizas en tus materias e investigaciones.
        </p>
        
        <div class="flex flex-wrap justify-center gap-4 md:gap-8">
            <!-- Badges de Software con Iconos Oficiales SVG -->
            <div class="glass-panel px-6 py-5 flex flex-col items-center justify-center w-[150px] hover:border-primary/30 transition-colors">
                <svg class="w-12 h-12 mb-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">
                    <defs>
                        <linearGradient id="SVGKqV9jdVi" x1="-134.811" x2="-134.772" y1="-103.284" y2="-103.323" gradientTransform="matrix(721.094 0 0 -482.937 97213.595 -49874.512)" gradientUnits="userSpaceOnUse">
                            <stop offset="0" stop-color="#cbced0"/>
                            <stop offset="1" stop-color="#84838b"/>
                        </linearGradient>
                        <linearGradient id="SVG5aLaoevq" x1="-135.378" x2="-135.339" y1="-102.985" y2="-103.024" gradientTransform="matrix(398 0 0 -406.124 53893 -41812.836)" gradientUnits="userSpaceOnUse">
                            <stop offset="0" stop-color="#276dc3"/>
                            <stop offset="1" stop-color="#165caa"/>
                        </linearGradient>
                    </defs>
                    <path fill="url(#SVGKqV9jdVi)" d="M16 23.956c-7.732 0-14-4.2-14-9.376S8.268 5.2 16 5.2s14 4.2 14 9.38s-6.268 9.376-14 9.376M18.143 8.87C12.266 8.87 7.5 11.74 7.5 15.28s4.764 6.41 10.641 6.41s10.214-1.962 10.214-6.41s-4.335-6.41-10.212-6.41"/>
