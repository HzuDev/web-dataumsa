---
// Componente Hero Bento Grid para DataUMSA
import Button from "./Button.astro";
import Badge from "./Badge.astro";
import TextReveal from "./TextReveal.astro";
---

<div class="max-w-7xl w-full mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6 animate-fade-in py-10">
    {/* Tarjeta Principal (2x2) */}
    <div class="lg:col-span-2 lg:row-span-2 bg-bg-dark-surface rounded-[2.5rem] p-8 lg:p-12 relative overflow-hidden flex flex-col justify-between group bento-card shadow-lg border border-border-dark hover:border-primary/30 hover:shadow-[0_25px_50px_-12px_rgba(41,185,242,0.25)]">
        {/* Fondo de grilla estilo ingeniería/datos dibujado con CSS */}
        <div
            class="absolute inset-0 opacity-[0.03] group-hover:opacity-[0.05] transition-opacity"
            style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 24px 24px;"
        ></div>

        <div class="absolute -right-20 -top-20 w-64 h-64 bg-primary rounded-full mix-blend-multiply filter blur-3xl opacity-20 group-hover:opacity-40 transition-opacity animate-float"></div>

        <div class="relative z-10 space-y-8">
            <Badge variant="dark" dotColor="bg-primary">
                Plataforma oficial de recolección UMSA
            </Badge>

            <div class="space-y-4">
                <h1 class="text-5xl lg:text-6xl font-black tracking-tight text-white leading-none">
                    <TextReveal variant="light">DataUMSA</TextReveal>
                </h1>
                <h2 class="text-2xl lg:text-3xl font-bold leading-tight text-text-inverse/90">
                    Investigación y{" "}
                    <TextReveal variant="light">
                        recolección de datos
                    </TextReveal>{" "}
                    avanzada.
                </h2>
            </div>

            <p class="text-lg text-text-dark-muted leading-relaxed max-w-md">
                Herramientas profesionales, soberanía total de tu información y
                trabajo <span class="font-bold text-white">100% offline</span>.
                Diseñada por y para la comunidad.
            </p>
        </div>

        <div class="relative z-10 flex flex-wrap gap-3 mt-10">
            <Button
                href="https://app-dataumsa.sociest.org/accounts/login/"
                variant="bento-primary"
                target="_blank"
            >
                Acceder a la Plataforma
            </Button>
            <Button
                href="/la-plataforma/caracteristicas"
                variant="bento-secondary"
            >
                Explorar Características
            </Button>
        </div>
    </div>

    {/* Tarjeta 1: Formularios */}
    <a
        href="/la-plataforma/caracteristicas#formularios"
        class="bg-white/80 backdrop-blur-md rounded-[2rem] p-7 flex flex-col justify-between bento-card transition-all duration-500 border border-border/80 hover:border-primary/40 hover:shadow-lg hover:-translate-y-1 relative overflow-hidden group no-underline text-inherit"
    >
        <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

        {/* Micro-indicador interactivo */}
        <div class="flex justify-end w-full relative z-10">
            <span class="text-text-muted/40 group-hover:text-primary group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-300">
                <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M7 17L17 7M17 7H7M17 7V17"
                    ></path>
                </svg>
            </span>
        </div>

        {/* CSS Asset: Formulario Complejo Ampliado */}
        <div class="w-20 h-20 my-2 relative z-10 bento-icon transition-transform duration-500 group-hover:scale-105">
            <div class="absolute inset-0 bg-primary/10 rounded-2xl border border-primary/25 p-3.5 flex flex-col justify-center gap-2.5 shadow-xs">
                <div class="w-3/4 h-2 bg-primary/50 rounded-full"></div>
                <div class="w-full h-2 bg-primary/25 rounded-full"></div>
                <div class="flex gap-2.5 items-center mt-0.5">
                    <div class="w-4 h-4 rounded-md bg-primary flex items-center justify-center shadow-xs">
                        <div class="w-1.5 h-2.5 border-b-2 border-r-2 border-white transform rotate-45 -mt-0.5"></div>
                    </div>
                    <div class="w-3/5 h-2 bg-primary/40 rounded-full"></div>
                </div>
            </div>
        </div>

        <div class="relative z-10">
            <h4 class="text-lg font-bold text-text-main mb-1">
                Formularios complejos
            </h4>
            <p class="text-sm font-medium text-text-muted">
                Lógica avanzada y saltos condicionales
            </p>
        </div>
    </a>

    {/* Tarjeta 2: Android App */}
    <a
        href="/app-movil/dataumsa-collect"
        class="bg-white/80 backdrop-blur-md rounded-[2rem] p-7 flex flex-col justify-between bento-card transition-all duration-500 border border-border/80 hover:border-primary/40 hover:shadow-lg hover:-translate-y-1 relative overflow-hidden group no-underline text-inherit"
    >
        <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

        {/* Micro-indicador interactivo */}
        <div class="flex justify-end w-full relative z-10">
            <span class="text-text-muted/40 group-hover:text-primary group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-300">
                <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M7 17L17 7M17 7H7M17 7V17"
                    ></path>
                </svg>
            </span>
        </div>

        {/* CSS Asset: App Offline Ampliado */}
        <div class="w-20 h-20 my-2 relative z-10 animate-float bento-icon flex items-center justify-center">
            <div class="relative w-14 h-20 border-[3px] border-primary-dark/30 rounded-[16px] bg-primary/5 p-1.5 flex flex-col items-center shadow-xs">
                <div class="w-5 h-1 bg-primary-dark/40 rounded-full mb-1.5"></div>
                <div class="w-full flex-1 bg-primary/10 rounded-md overflow-hidden flex flex-col gap-1.5 p-1">
                    <div class="w-full h-2.5 bg-primary/25 rounded-xs"></div>
                    <div class="w-4/5 h-2.5 bg-primary/20 rounded-xs"></div>
                    <div class="w-full h-2.5 bg-primary/15 rounded-xs"></div>
                </div>
                <div class="absolute -right-2.5 top-5 w-5 h-5 bg-primary-dark rounded-full flex items-center justify-center shadow-[0_0_12px_rgba(6,136,186,0.4)]">
                    <div class="w-2.5 h-0.5 bg-white rotate-45 absolute"></div>
                    <div class="w-2.5 h-0.5 bg-white -rotate-45 absolute"></div>
                </div>
            </div>
        </div>

        <div class="relative z-10">
            <h4 class="text-lg font-bold text-text-main mb-1">
                App Android dedicada
            </h4>
            <p class="text-sm font-medium text-text-muted">
                Operación 100% offline garantizada
            </p>
        </div>
    </a>

    {/* Tarjeta 3: Análisis */}
    <a
        href="/la-plataforma/caracteristicas#analisis"
        class="bg-white/80 backdrop-blur-md rounded-[2rem] p-7 flex flex-col justify-between bento-card transition-all duration-500 border border-border/80 hover:border-primary/40 hover:shadow-lg hover:-translate-y-1 relative overflow-hidden group no-underline text-inherit"
    >
        <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

        {/* Micro-indicador interactivo */}
        <div class="flex justify-end w-full relative z-10">
            <span class="text-text-muted/40 group-hover:text-primary group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-300">
                <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M7 17L17 7M17 7H7M17 7V17"
                    ></path>
                </svg>
            </span>
        </div>

        {/* CSS Asset: Gráfico de barras ascendente Ampliado */}
        <div class="w-20 h-20 my-2 relative z-10 bento-icon flex items-end justify-between px-1 pb-2 border-b-2 border-primary/25">
            <div class="w-4 h-6 bg-primary/30 rounded-t-sm group-hover:h-9 transition-all duration-300"></div>
            <div class="w-4 h-10 bg-primary/55 rounded-t-sm group-hover:h-13 transition-all duration-300 delay-75"></div>
            <div class="w-4 h-15 bg-primary-dark rounded-t-sm group-hover:h-17 transition-all duration-300 delay-150 shadow-[0_0_12px_rgba(6,136,186,0.35)]"></div>
        </div>

        <div class="relative z-10">
            <h4 class="text-lg font-bold text-text-main mb-1">
                Análisis profesional
            </h4>
            <p class="text-sm font-medium text-text-muted">
                Exportación directa a SPSS y Stata
            </p>
        </div>
    </a>

    {/* Tarjeta 4: Soberanía */}
    <a
        href="/sobre-dataumsa/historia"
        class="bg-white/80 backdrop-blur-md rounded-[2rem] p-7 flex flex-col justify-between bento-card transition-all duration-500 border border-border/80 hover:border-primary/40 hover:shadow-lg hover:-translate-y-1 relative overflow-hidden group no-underline text-inherit"
    >
        <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

        {/* Micro-indicador interactivo */}
        <div class="flex justify-end w-full relative z-10">
            <span class="text-text-muted/40 group-hover:text-primary group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-300">
                <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M7 17L17 7M17 7H7M17 7V17"
                    ></path>
                </svg>
            </span>
        </div>

        {/* CSS Asset: Escudo / Nodo de Datos Geométrico Ampliado */}
        <div class="w-20 h-20 my-2 relative z-10 flex items-center justify-center bento-icon">
            <div class="absolute inset-1.5 border-2 border-primary/20 rounded-2xl rotate-45 group-hover:rotate-90 transition-transform duration-700"></div>
            <div class="absolute inset-3.5 bg-primary/10 border border-primary/40 rounded-xl -rotate-12 group-hover:rotate-0 transition-transform duration-500"></div>
            <div class="w-7 h-7 bg-primary-dark rounded-md rotate-45 shadow-[0_0_16px_rgba(6,136,186,0.45)] flex items-center justify-center">
                <div class="w-2 h-2 bg-white rounded-full"></div>
            </div>
        </div>

        <div class="relative z-10">
            <h4 class="text-lg font-bold text-text-main mb-1">
                Soberanía de datos
            </h4>
            <p class="text-sm font-medium text-text-muted">
                Custodiados en Datacenter UMSA
            </p>
        </div>
    </a>
</div>

<style>
    @keyframes float {
        0%,
        100% {
            transform: translateY(0px);
        }
        50% {
            transform: translateY(-8px);
        }
    }

    .animate-float {
        animation: float 4s ease-in-out infinite;
    }

    .bento-card {
        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease,
            border-color 0.3s ease;
    }

    .bento-card:hover {
        transform: translateY(-4px);
    }
</style>
