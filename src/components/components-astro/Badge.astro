---
// Componente de Badge / Etiqueta Reutilizable para DataUMSA
interface Props {
  variant?: 'glass' | 'dark' | 'mono' | 'primary';
  dotColor?: string;
  class?: string;
}

const {
  variant = 'glass',
  dotColor,
  class: className = ''
} = Astro.props;

// Clases base para alineación y comportamiento flex
const baseClasses = "inline-flex items-center gap-2 select-none transition-all duration-300";

// Estilos de variantes basados en los mocks del proyecto
const variantStyles = {
  glass: "px-3 py-1.5 rounded-xl bg-white/10 border border-white/10 text-white backdrop-blur-sm text-xs font-bold tracking-widest uppercase",
  dark: "px-4 py-2 rounded-2xl bg-bg-dark-surface border border-border-dark text-primary-light text-xs font-bold tracking-widest uppercase",
  mono: "px-3 py-1 rounded-full bg-bg-dark border border-border-dark text-text-dark-muted text-xs font-mono uppercase tracking-widest",
  primary: "px-4 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary-dark text-xs font-bold tracking-wider uppercase"
};

const variantClasses = variantStyles[variant] || variantStyles.glass;
---

<div class:list={[baseClasses, variantClasses, className]}>
  {dotColor && (
    <span class:list={["w-2 h-2 rounded-full animate-pulse flex-shrink-0", dotColor]}></span>
  )}
  <slot />
</div>
