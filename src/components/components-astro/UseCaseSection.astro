---
import { FiBookOpen, FiClipboard, FiGlobe, FiArrowRight } from "react-icons/fi";
import Badge from "./Badge.astro";
import TextReveal from "./TextReveal.astro";

// Los datos se mantienen limpios y separados
const cases = [
    {
        id: "01",
        shortTitle: "Tesis & Proyectos",
        title: "Investigación y Tesis",
        desc: "Diseña formularios con lógicas de salto complejas. Exporta tu data limpia y lista para SPSS o Stata, ahorrando semanas de tabulación manual.",
        icon: FiBookOpen,
        color: "text-accent-dark",
        bg: "bg-accent-light/10",
        borderFocus: "focus-within:border-accent/40 hover:border-accent/40",
        gradient: "from-accent-light/20 to-transparent",
        href: "/la-plataforma/casos-de-uso#tesis"
    },
    {
        id: "02",
        shortTitle: "Prácticas de Campo",
        title: "Docencia y Trabajo de Campo",
        desc: "Lleva a tus estudiantes a zonas sin cobertura. La app dedicada garantiza recolección 100% offline y sincronización en bloque al recuperar la señal.",
        icon: FiClipboard,
        color: "text-success-dark",
        bg: "bg-success-light/10",
        borderFocus: "focus-within:border-success/40 hover:border-success/40",
        gradient: "from-success-light/20 to-transparent",
        href: "/la-plataforma/casos-de-uso#docencia"
    },
    {
        id: "03",
        shortTitle: "Censos & Operativos",
        title: "Operativos a Gran Escala",
        desc: "Infraestructura robusta probada en el Censo Universitario. Coordina cientos de encuestadores simultáneos con tableros de control en tiempo real.",
        icon: FiGlobe,
        color: "text-primary-dark",
        bg: "bg-primary-light/10",
        borderFocus: "focus-within:border-primary/40 hover:border-primary/40",
        gradient: "from-primary-light/20 to-transparent",
        href: "/la-plataforma/casos-de-uso#censos"
    }
];
---

<section class="w-full py-24 px-4 sm:px-8 overflow-hidden bg-bg-main relative">
    <!-- Glow de fondo general -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[500px] bg-primary/5 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="max-w-7xl w-full mx-auto relative z-10">
        
        <!-- Encabezado alineado a la izquierda para contrastar con el acordeón -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-12">
            <div class="max-w-2xl">
                <Badge variant="mono" class="mb-6">
                    <span class="text-text-muted">Alcance del Sistema</span>
                </Badge>
                <h2 class="text-text-main text-4xl md:text-5xl lg:text-6xl font-black tracking-tight leading-none" style="font-family: var(--font-display);">
                    Escalabilidad <TextReveal variant="light">real.</TextReveal>
                </h2>
            </div>
            <p class="text-text-muted text-lg font-medium max-w-sm md:text-right pb-2" style="font-family: var(--font-sans);">
                Selecciona un entorno para explorar cómo la plataforma se adapta a diferentes niveles de rigor académico.
            </p>
        </div>

        <!-- Contenedor del Acordeón Elástico (Grid en Móvil, Acordeón Elástico en Desktop) -->
        <div class="grid grid-cols-1 md:grid-cols-3 lg:flex lg:flex-row w-full gap-4 lg:gap-6 lg:h-[600px]">
            
            {cases.map((item) => (
                <a 
                    href={item.href}
                    class={`group elastic-panel relative flex flex-col justify-between p-6 sm:p-8 lg:p-0 lg:flex-1 lg:hover:flex-[4] lg:focus-within:flex-[4] rounded-[2rem] border border-border ${item.borderFocus} bg-white/60 backdrop-blur-md overflow-hidden cursor-pointer shadow-sm hover:shadow-md transition-all duration-300`}
                >
                    <!-- Fondo gradiente que aparece al interactuar -->
                    <div class={`absolute inset-0 bg-gradient-to-br ${item.gradient} opacity-40 lg:opacity-0 lg:group-hover:opacity-100 transition-opacity duration-700 pointer-events-none`}></div>

                    <!-- VISTA DESKTOP: ESTADO CONTRAÍDO (Solo en lg+, visible por defecto, se desvanece en hover) -->
                    <div class="hidden lg:flex absolute inset-0 p-8 flex-col justify-between items-center z-20 transition-all duration-500 group-hover:opacity-0 group-hover:-translate-y-4 group-hover:pointer-events-none">
                        <!-- Icono -->
                        <div class="w-14 h-14 rounded-2xl bg-black/5 dark:bg-white/5 flex items-center justify-center border border-border/50">
                            <item.icon className="w-6 h-6 text-text-muted" strokeWidth={2} />
                        </div>
                        
                        <!-- Título Vertical (Solo en Desktop contraído) -->
                        <h3 class="font-bold text-xl tracking-widest text-text-muted uppercase whitespace-nowrap [writing-mode:vertical-lr] rotate-180" style="font-family: var(--font-display);">
                            {item.shortTitle}
                        </h3>

                        <span class="font-mono text-text-muted/40 font-semibold">{item.id}</span>
                    </div>

                    <!-- VISTA DESKTOP: ESTADO EXPANDIDO (Solo en lg+, oculto por defecto, revelado en hover) -->
                    <div class="hidden lg:flex absolute inset-0 p-12 flex-col justify-end z-30 opacity-0 group-hover:opacity-100 transition-all duration-700 transform translate-y-12 group-hover:translate-y-0 pointer-events-none group-hover:pointer-events-auto">
                        <div class="w-full min-w-[420px] max-w-lg">
                            <div class={`w-16 h-16 rounded-2xl ${item.bg} border border-current/10 flex items-center justify-center mb-6 shadow-sm`}>
                                <item.icon className={`w-8 h-8 ${item.color}`} strokeWidth={2} />
                            </div>
                            
                            <h3 class="text-3xl lg:text-4xl font-black text-text-main mb-4 leading-tight" style="font-family: var(--font-display);">
                                {item.title}
                            </h3>
                            
                            <p class="text-text-muted font-medium text-lg leading-relaxed mb-8" style="font-family: var(--font-sans);">
                                {item.desc}
                            </p>
                            
                            <div class={`inline-flex items-center gap-3 font-bold text-sm uppercase tracking-wider ${item.color} group/btn`}>
                                <span class="border-b-2 border-transparent group-hover/btn:border-current transition-colors pb-0.5">
                                    Ver especificaciones
                                </span>
                                <div class="p-2 rounded-full bg-current/10 group-hover/btn:bg-current group-hover/btn:text-white transition-colors duration-300 transform group-hover/btn:translate-x-1">
                                    <FiArrowRight className="w-4 h-4" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- VISTA MÓVIL Y TABLET (< lg): Contenido legible directamente sin depender de hover -->
                    <div class="lg:hidden flex flex-col justify-between h-full z-20 gap-6">
                        <div class="flex items-start justify-between">
                            <div class={`w-14 h-14 rounded-2xl ${item.bg} border border-current/10 flex items-center justify-center shadow-sm`}>
                                <item.icon className={`w-7 h-7 ${item.color}`} strokeWidth={2} />
                            </div>
                            <span class="font-mono text-text-muted/60 font-bold text-sm">{item.id}</span>
                        </div>
                        <div>
                            <h3 class="text-2xl font-black text-text-main mb-3 leading-tight" style="font-family: var(--font-display);">
                                {item.title}
                            </h3>
                            <p class="text-text-muted font-normal text-base leading-relaxed" style="font-family: var(--font-sans);">
                                {item.desc}
                            </p>
                        </div>
                        <div class={`inline-flex items-center gap-2 font-bold text-xs uppercase tracking-wider ${item.color} pt-2`}>
                            <span>Ver especificaciones</span>
                            <FiArrowRight className="w-4 h-4" />
                        </div>
                    </div>
                </a>
            ))}

        </div>
    </div>
</section>

<style>
    /* CSS personalizado para lograr la física de elasticidad perfecta */
    .elastic-panel {
        /* La curva de bezier es la clave: inicia rápido y se frena suavemente (estilo Apple) */
        transition: 
            flex 0.8s cubic-bezier(0.16, 1, 0.3, 1),
            background-color 0.5s ease,
            border-color 0.5s ease;
        will-change: flex;
    }
</style>