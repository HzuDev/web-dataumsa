---
import { ClientRouter } from 'astro:transitions';
import { RoundedDrawerNavExample } from "../components/Navbar";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "DataUMSA - Plataforma moderna y robusta para gestión de datos, encuestas y flujos de trabajo institucionales.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title} | DataUMSA</title>
    <meta name="title" content={`${title} | DataUMSA`} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | DataUMSA`} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={`${title} | DataUMSA`} />
    <meta property="twitter:description" content={description} />

    <!-- View Transitions -->
    <ClientRouter />
  </head>
  <body class="bg-glow-container">
    <RoundedDrawerNavExample client:load>
      <main>
        <slot />
      </main>
      <footer
        class="w-full border-t border-border bg-slate-100/50 py-16 px-8 mt-auto flex justify-center backdrop-blur-md"
      >
        <div class="w-full max-w-[1200px] flex flex-col gap-12">
          <div class="max-w-[400px]">
            <span class="text-2xl font-extrabold text-text-main tracking-tight"
              >DATA<span class="text-primary">UMSA</span></span
            >
            <p class="text-text-muted text-[0.95rem] mt-4 leading-relaxed">
              Soluciones avanzadas de análisis y recolección de información para
              la academia y empresas.
            </p>
          </div>
          <div
            class="flex flex-col md:flex-row justify-between items-center border-t border-border pt-8 gap-4 text-text-muted text-sm"
          >
            <p>
              &copy; {new Date().getFullYear()} DataUMSA. Todos los derechos reservados.
            </p>
            <p class="text-text-muted">
              Construido con <a
                href="https://astro.build/"
                target="_blank"
                rel="noopener"
                class="text-text-main font-semibold hover:text-primary transition-colors"
                >Astro</a
              > y <a
                href="https://starlight.astro.build/"
                target="_blank"
                rel="noopener"
                class="text-text-main font-semibold hover:text-primary transition-colors"
                >Starlight</a
              >.
            </p>
          </div>
        </div>
      </footer>
    </RoundedDrawerNavExample>
  </body>
</html>
